{
  "name": "imperfect-form",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pose": "node scripts/test-pose-detection.cjs",
    "test:pose:desktop": "node scripts/test-pose-detection.cjs --platform desktop",
    "test:pose:mobile": "node scripts/test-pose-detection.cjs --platform mobile",
    "test:pose:performance": "node scripts/test-pose-detection.cjs --suite performance",
    "test:pose:compatibility": "node scripts/test-pose-detection.cjs --suite device-compatibility",
    "test:pose:errors": "node scripts/test-pose-detection.cjs --suite error-handling",
    "test:pose:all": "node scripts/test-pose-detection.cjs --platform all --suite pose-detection",
    "test:pose:headed": "node scripts/test-pose-detection.cjs --headed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "deploy:self": "hardhat run scripts/deploy-self-protocol.js --network celoMainnet",
    "self:switch-mainnet": "node scripts/switch-to-mainnet.js",
    "self:test": "node scripts/test-self-protocol.cjs",
    "self:health": "curl -X GET http://localhost:3000/api/self/verify",
    "self:check": "node scripts/check-self-integration.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1087.0",
    "@aws-sdk/client-polly": "^3.1087.0",
    "@divvi/referral-sdk": "^2.3.0",
    "@farcaster/miniapp-sdk": "0.3.0",
    "@farcaster/miniapp-wagmi-connector": "^2.0.0",
    "@google/genai": "2.11.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-visually-hidden": "^1.2.7",
    "@selfxyz/contracts": "^1.2.3",
    "@selfxyz/core": "1.2.0-beta.1",
    "@selfxyz/qrcode": "^1.0.24",
    "@supabase/supabase-js": "^2.110.5",
    "@tanstack/react-query": "^5.101.2",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "cuelume": "0.1.2",
    "ethers": "^6.17.0",
    "lucide-react": "^1.24.0",
    "next": "^16.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "viem": "^2.55.2",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nomicfoundation/hardhat-ethers": "^4.0.14",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "hardhat": "^3.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@selfxyz/common>fs": "-",
      "@coinbase/wallet-sdk": "^4.3.7",
      "@tensorflow/tfjs-backend-wasm": "^4.22.0",
      "ethers": "^6.15.0",
      "zod": "^3.25.76"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,json}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
