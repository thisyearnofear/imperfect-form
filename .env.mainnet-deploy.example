# SELF PROTOCOL MAINNET DEPLOYMENT
# Minimal configuration for aggressive zero-user migration

NODE_ENV=production

# Application URL (UPDATE THIS)
NEXT_PUBLIC_APP_URL=https://imperfectform.fun

# Deployment Private Key (PASTE YOUR KEY HERE)
PRIVATE_KEY=

# Auto-configured values (will be set by deployment script)
NEXT_PUBLIC_SELF_NETWORK=celo_mainnet
NEXT_PUBLIC_SELF_CHAIN_ID=42220
NEXT_PUBLIC_SELF_HUB_ADDRESS=0xe57F4773bd9c9d8b6Cd70431117d353298B9f5BF
NEXT_PUBLIC_SELF_SCOPE_NAME=imperfect-form-fitness
NEXT_PUBLIC_SELF_CONFIG_ID=0x7b6436b0c98f62380866d9432c2af0ee08ce16a171bda6951aecd95ee1307d61

# Contract address (will be auto-populated after deployment)
NEXT_PUBLIC_VERIFIED_FITNESS_CONTRACT=
NEXT_PUBLIC_SELF_SCOPE=

# External services (optional)
NEYNAR_API_KEY=
NEXT_PUBLIC_NEYNAR_CLIENT_ID=

# DEPLOYMENT CHECKLIST:
# □ Update NEXT_PUBLIC_APP_URL with your domain
# □ Add your PRIVATE_KEY (keep secure!)
# □ Ensure 1+ CELO in deployer wallet
# □ Run: cp .env.mainnet-deploy.example .env.local
# □ Run: npm run deploy:mainnet-aggressive
