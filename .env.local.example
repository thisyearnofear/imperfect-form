# WalletConnect Configuration
# Get your project ID from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Neynar Configuration (for Farcaster integration)
NEXT_PUBLIC_NEYNAR_CLIENT_ID=your_neynar_client_id_here

# Monad Mainnet Contract (deploy via Remix)
NEXT_PUBLIC_MONAD_CONTRACT_ADDRESS=your_deployed_contract_address_here

# Base Builder Codes (ERC-8021 Attribution)
# Get your Builder Code from https://base.dev (Settings → Builder Code)
# Your code: bc_ozh43mmg
NEXT_PUBLIC_BUILDER_CODE=bc_ozh43mmg

# AI Coaching Providers
# Priority: Gemini → Groq → Venice → Bedrock (optional) → local
# Primary: Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Fast fallback: Groq — https://console.groq.com/keys (never commit real keys)
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL_ID=llama-3.1-8b-instant

# Fallback: Venice AI (privacy-focused)
# Get your API key from https://venice.ai
VENICE_API_KEY=your_venice_api_key_here

# Other environment variables
# Add any other required environment variables here
