# WalletConnect Configuration
# Get your project ID from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Neynar Configuration (for Farcaster integration)
NEXT_PUBLIC_NEYNAR_CLIENT_ID=your_neynar_client_id_here

# Monad Mainnet Contract (deploy via Remix)
NEXT_PUBLIC_MONAD_CONTRACT_ADDRESS=your_deployed_contract_address_here

