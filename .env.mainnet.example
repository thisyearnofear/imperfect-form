# =============================================================================
# SELF PROTOCOL MAINNET CONFIGURATION
# =============================================================================
# Environment configuration for Self Protocol mainnet deployment
# Copy this file to .env.local for production mainnet deployment

# =============================================================================
# DEPLOYMENT ENVIRONMENT
# =============================================================================
NODE_ENV=production

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Your production application URL
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# =============================================================================
# SELF PROTOCOL CONFIGURATION
# =============================================================================
# Self Protocol verification endpoint (auto-generated from NEXT_PUBLIC_APP_URL)
NEXT_PUBLIC_SELF_ENDPOINT=${NEXT_PUBLIC_APP_URL}/api/self/verify

# Network configuration (automatically detected based on NODE_ENV)
# Mainnet: celo_mainnet (Chain ID: 42220)
# Hub Address: 0xe57F4773bd9c9d8b6Cd70431117d353298B9f5BF
NEXT_PUBLIC_SELF_NETWORK=celo_mainnet
NEXT_PUBLIC_SELF_CHAIN_ID=42220
NEXT_PUBLIC_SELF_HUB_ADDRESS=0xe57F4773bd9c9d8b6Cd70431117d353298B9f5BF

# Contract addresses (set after deployment)
NEXT_PUBLIC_VERIFIED_FITNESS_CONTRACT=YOUR_DEPLOYED_CONTRACT_ADDRESS
NEXT_PUBLIC_SELF_SCOPE=YOUR_CALCULATED_SCOPE

# Application scope (centrally configured, should not change)
NEXT_PUBLIC_SELF_SCOPE_NAME=imperfect-form-fitness

# Configuration ID (matches frontend disclosures)
NEXT_PUBLIC_SELF_CONFIG_ID=0x7b6436b0c98f62380866d9432c2af0ee08ce16a171bda6951aecd95ee1307d61

# =============================================================================
# BLOCKCHAIN CONFIGURATION
# =============================================================================
# Private key for contract deployment (keep secure!)
PRIVATE_KEY=your_mainnet_private_key_here

# RPC URLs (optional, defaults are used if not specified)
CELO_MAINNET_RPC_URL=https://forno.celo.org

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Neynar (Farcaster integration)
NEYNAR_API_KEY=your_neynar_api_key
NEXT_PUBLIC_NEYNAR_CLIENT_ID=your_neynar_client_id

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. NEVER commit this file to version control with real values
# 2. Use environment-specific deployment keys with minimal permissions
# 3. Verify all addresses before mainnet deployment
# 4. Test thoroughly on testnet before migrating
# 5. Consider using a hardware wallet or multisig for mainnet deployment

# =============================================================================
# MAINNET DEPLOYMENT CHECKLIST
# =============================================================================
# □ Verified contract addresses on Celo mainnet
# □ Tested Self Protocol integration with real passports
# □ Confirmed frontend disclosures match CONFIG_ID
# □ Updated all environment variables
# □ Backup deployment information
# □ Monitor contract interactions post-deployment
