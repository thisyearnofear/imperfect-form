# Environment Variables for Imperfect Form

# App Configuration
NEXT_PUBLIC_APP_URL=https://imperfectform.fun
NEXT_PUBLIC_BASE_URL=https://imperfectform.fun
NEXT_PUBLIC_API_URL=https://imperfectform.fun/api

# Contract Addresses
NEXT_PUBLIC_LEADERBOARD_CONTRACT=0x...
NEXT_PUBLIC_LEADERBOARD_CONTRACT_POLYGON=0x28FE19798fe0A0276CF474f2DCC3749313f1aC0A
NEXT_PUBLIC_LEADERBOARD_CONTRACT_BASE=0x58DC4867f87473BF9874892dE8e62C48958c8d96
NEXT_PUBLIC_LEADERBOARD_CONTRACT_CELO=0xB0cbC7325EbC744CcB14211CA74C5a764928F273
NEXT_PUBLIC_MONAD_CONTRACT_ADDRESS=0x... # Deploy on Monad Mainnet (chainId 143)
NEXT_PUBLIC_VERIFIED_FITNESS_CONTRACT=0x41f2fA6E60A34c26BD2C467d21EcB0a2f9087B03

# Third-party Services
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_NEYNAR_CLIENT_ID=your_neynar_client_id
NEYNAR_API_KEY=your_neynar_api_key

# AI Coaching Providers
# Priority: Gemini → Groq → Venice → Bedrock (optional) → local heuristics
# Primary: Gemini 3 Flash Preview (3x faster, frontier-level reasoning)
# Get your free API key from https://aistudio.google.com/app/apikey
# Cost: $0.50/$3 per 1M tokens (with 90% caching discount available)
GEMINI_API_KEY=your_gemini_api_key_here

# Fast fallback: Groq (Llama) — live coaching latency
# Get a key at https://console.groq.com/keys — never commit real keys
GROQ_API_KEY=your_groq_api_key_here
# Optional model override (default: llama-3.1-8b-instant)
# GROQ_MODEL_ID=llama-3.3-70b-versatile

# Fallback: Venice AI (privacy-focused, uncensored alternative)
# Get your API key from https://venice.ai (Pro subscription includes $10 free credits)
# Cost: $0.10/$0.10 per 1M tokens (pay-as-you-go)
VENICE_API_KEY=your_venice_api_key_here

# Optional fallback: AWS Bedrock Nova 2 Lite (coaching text, not required for speech)
# Needs an IAM key pair (or set AWS_BEARER_TOKEN_BEDROCK instead)
# Model must be a cross-region inference profile ID, not a bare model ID
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

# TTS / coach voice (demo narration + live coaching)
# Cascade (auto): ElevenLabs → Amazon Polly → browser Web Speech
# User preference: settings → VOICE ENGINE (auto | elevenlabs | polly | browser)
# Never commit real keys
ELEVENLABS_API_KEY=
# Optional default + per-persona voice IDs (ElevenLabs dashboard)
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_VOICE_SNEL=
# ELEVENLABS_VOICE_STEDDIE=
# ELEVENLABS_VOICE_RASTA=
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# Polly uses the same AWS_* creds; optional voice overrides (neural)
# POLLY_VOICE_SNEL=Joanna
# POLLY_VOICE_STEDDIE=Stephen
# POLLY_VOICE_RASTA=Matthew

# Self Protocol (verification endpoint derives from NEXT_PUBLIC_APP_URL)

# Analytics
ANALYTICS_API_KEY=your_analytics_api_key

# Development
NODE_ENV=development
