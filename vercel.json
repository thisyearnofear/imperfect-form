{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cd next && npm run build",
  "devCommand": "cd next && npm run dev",
  "installCommand": "npm install --legacy-peer-deps && cd next && npm install --legacy-peer-deps",
  "outputDirectory": "next/.next",
  "framework": "nextjs",

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
